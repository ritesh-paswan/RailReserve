RAILCORE_API_KEY=replace-with-your-railcore-key
RAILCORE_BASE_URL=https://ir.railcore.tech/v1
PORT=3000
REQUEST_TIMEOUT_MS=20000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60

# Optional smoke-test inputs; choose a real provider-supported itinerary/date.
SMOKE_BASE_URL=http://127.0.0.1:3000
SMOKE_STATION_QUERY=Delhi
SMOKE_FROM=NDLS
SMOKE_TO=MMCT
SMOKE_TRAIN_NUMBER=12952
SMOKE_JOURNEY_DATE=YYYY-MM-DD
SMOKE_CLASS_CODE=3A
SMOKE_QUOTA_CODE=GN
