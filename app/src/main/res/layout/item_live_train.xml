<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/live_search_card"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/liveTrainName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ink"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/liveTrainType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/liveTrainDeparture" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/liveTrainSource" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/muted" android:textSize="12sp" />
            <TextView android:id="@+id/liveTrainDepartureDay" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/muted" android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:padding="8dp"
            android:text="TO"
            android:textColor="@color/brand"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">
            <TextView android:id="@+id/liveTrainArrival" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/liveTrainDestination" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="end" android:textColor="@color/muted" android:textSize="12sp" />
            <TextView android:id="@+id/liveTrainArrivalDay" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="end" android:textColor="@color/muted" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/liveTrainDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/live_route_badge"
        android:padding="10dp"
        android:textColor="@color/brand_dark"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/liveTrainFare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/brand_dark"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/liveTrainFareButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/button_secondary"
        android:minHeight="48dp"
        android:text="Check fare estimate"
        android:textAllCaps="false"
        android:textColor="@color/brand_dark"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/liveTrainAvailability"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <Button
        android:id="@+id/liveTrainAvailabilityButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/button_secondary"
        android:minHeight="48dp"
        android:text="Check seat availability"
        android:textAllCaps="false"
        android:textColor="@color/brand_dark"
        android:textStyle="bold" />

    <Button
        android:id="@+id/liveTrainScheduleButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/button_secondary"
        android:minHeight="48dp"
        android:text="View scheduled stops"
        android:textAllCaps="false"
        android:textColor="@color/brand_dark"
        android:textStyle="bold" />
</LinearLayout>
